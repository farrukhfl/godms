# URL of the Express API. Update this to the deployed backend URL for production builds.
VITE_API_BASE_URL=http://localhost:3001

# DRMS API used for account sign-in and customer merchant applications.
VITE_DRMS_API_BASE_URL=https://dev-derps.gotmsolutions.com/api

# Browser integration key used only to request a short-lived anonymous customer token.
VITE_DRMS_API_KEY=replace_with_customer_application_api_key

# Google reCAPTCHA v2 Site Key
VITE_RECAPTCHA_SITE_KEY=6LeIxAcTAAAAAJcZVRqyHh71UMIEGNQ_MXjiZKhI

# ---------------------------------------------------------------------------
# Analytics (see ANALYTICS.md)
# ---------------------------------------------------------------------------

# PostHog project key. This is a publishable ingestion key and is expected to be
# visible in the browser bundle. Leave it empty to disable tracking entirely.
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://us.i.posthog.com

# ---------------------------------------------------------------------------
# Dashboard - SERVER-SIDE ONLY. These are read by the /api/insights-query
# function and must never be given a VITE_ prefix: Vite inlines any VITE_
# variable into the public bundle, which would publish these values.
# ---------------------------------------------------------------------------

# PostHog personal API key with read scope, and the numeric project id.
POSTHOG_READ_KEY=
POSTHOG_PROJECT_ID=
POSTHOG_API_HOST=https://us.posthog.com

# Password for /insights. Use a long random value.
INSIGHTS_PASSWORD=

# Optional. Pin the dashboard to one host, or "all" to show every host.
# Left unset, each deployment shows only its own traffic automatically.
INSIGHTS_HOST_FILTER=
