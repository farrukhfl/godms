# API port used by the local Express server.
PORT=3001

# Frontend origin allowed to call this API. Set this to the deployed frontend URL in production.
ALLOWED_ORIGIN=http://localhost:5173

# Reserved for the future email delivery integration.
EMAIL_API_KEY=replace_with_email_provider_key
EMAIL_FROM_ADDRESS=replace_with_verified_sender
EMAIL_TO_ADDRESS=replace_with_submission_recipient

# Reserved for the future CRM integration.
CRM_API_KEY=replace_with_crm_api_key
CRM_ENDPOINT=replace_with_crm_endpoint
